{
  "expo": {
    "name": "Meu Vizinho",
    "slug": "meuvizinho",
    "scheme": ["meuvizinho", "com.meuvizinho.app"],
    "version": "0.2.3",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "light",
    "androidNavigationBar": {
      "enforceContrast": false
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/adaptive-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meuvizinho.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos acessar sua câmera para enviar comprovante de residência",
        "NSPhotoLibraryUsageDescription": "Precisamos acessar suas fotos para enviar comprovante de residência"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.meuvizinho.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/adaptive-icon-foreground.png",
          "color": "#2563EB",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-navigation-bar"
    ],
    "extra": {
      "apiUrl": "https://api.bairronow.com.br",
      "eas": {
        "projectId": "05d6afa2-b8c1-4f85-9e43-a2ca10c65a63"
      },
      "router": {
        "origin": false
      },
      "kiwifyCheckoutUrl": "",
      "googleClientId": "1092069609858-rg2n14a53ag7r2edrus3u1t5t1fhan2h.apps.googleusercontent.com"
    },
    "owner": "xandeq"
  }
}
